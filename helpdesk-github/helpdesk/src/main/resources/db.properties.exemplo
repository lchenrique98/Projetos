# Copie este arquivo para "db.properties" (na mesma pasta) e preencha.
# O db.properties está no .gitignore e não deve ser enviado para o GitHub.
#
# Recomendado: criar um usuário só para a aplicação em vez de usar o root:
#   CREATE USER 'helpdesk_app'@'localhost' IDENTIFIED BY 'uma-senha-forte';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON helpdesk.* TO 'helpdesk_app'@'localhost';

db.url=jdbc:mysql://localhost:3306/helpdesk?serverTimezone=America/Sao_Paulo
db.usuario=helpdesk_app
db.senha=TROQUE_AQUI

# Código para se cadastrar como TÉCNICO na tela pública de cadastro.
# Quem digitar este código no campo "Código do técnico" vira técnico.
# Deixe vazio (ou apague a linha) para desativar essa opção.
tecnico.codigo=TROQUE_ESTE_CODIGO
